NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analítica (opcional). Si se dejan vacías, no se carga nada.
# GA4: pega el "Measurement ID" (formato G-XXXXXXXXXX) del panel de Google Analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Search Console: token de la verificación por "Etiqueta HTML" (solo el content, sin comillas).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile (anti-bot en login/registro). Si se deja vacío el widget
# NO se renderiza y el flujo funciona sin captcha. El backend valida con
# TURNSTILE_SECRET_KEY (en apps/api/.env) — ambas llaves deben ir juntas.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
